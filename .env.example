# ============================================================================
# OpenRecruiting — copy to `.env` and fill in. Never commit `.env`.
# Setup guides:  docs/setup/supabase.md   docs/setup/recall.md
#
# Only three values are strictly required to boot the backend:
#   SUPABASE_URL, SUPABASE_SECRET_KEY, SUPABASE_JWT_SECRET
# Everything else has a working local default, or disables a feature when blank.
# ============================================================================

# ---------------------------------------------------------------------------
# PUBLIC — frontend (NEXT_PUBLIC_*). Baked into the browser bundle. NOT secret.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Supabase's browser-safe key. Newer projects call this the "publishable" key,
# older ones "anon" -- they are the same thing. Set BOTH to the same value:
# landing reads the publishable name, the recruiter app accepts either.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_API_URL=http://localhost:8004
NEXT_PUBLIC_API_V2_URL=http://localhost:8004
NEXT_PUBLIC_APP_URL=http://localhost:3005
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# Staff admin portal (admin-app). Optional preview link target for assessment
# templates; the assessment UI is not part of this stack, so a blank value just
# leaves that one preview button pointing nowhere.
NEXT_PUBLIC_ASSESSMENT_UI_URL=

# Cookie domain shared between landing and the recruiter app.
# LEAVE BLANK for localhost: the code passes undefined, which scopes the cookie
# to the current host -- what you want when the two apps differ only by port.
# Set it (e.g. .example.com) only when serving them from sibling subdomains.
NEXT_PUBLIC_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# SECRET — backend / workers. Never expose these to the browser.
# ---------------------------------------------------------------------------
# Supabase (cloud project — see docs/setup/supabase.md).
# In the dashboard: Project Settings -> API.
#   SUPABASE_URL        = Project URL
#   SUPABASE_SECRET_KEY = the service_role / secret key (bypasses RLS)
#   SUPABASE_JWT_SECRET = Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# Auth
# Leave false on a personal instance: your Supabase auth settings already
# control who can sign in at all. Set true to require an invite as well.
SIGNUP_INVITE_ONLY=false
# Shared secret for service-to-service calls (X-Internal-Secret). Set any long
# random string; it only has to match across the containers in this stack.
INTERNAL_API_SECRET=change-me-local-only

# Where the browser apps live (used to build links in emails).
APP_URL=http://localhost:3005
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3005

# LLM / STT — bring your own keys. A feature whose key is blank is disabled,
# not broken.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# Recall.ai — meeting capture (see docs/setup/recall.md). Optional.
# ---------------------------------------------------------------------------
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
# The name the bot joins meetings under. If you change it you MUST also add the
# lowercased form to BOT_SPEAKER_NAMES in
# backend/app/services/recall_webhook/constants.py AND to _BOT_SPEAKER_NAMES in
# workers/feedback-agent/src/clients/supabase.py. The backend refuses to start
# if they disagree — otherwise the bot's own speech is scored as interviewer
# feedback. (It is code, not config, precisely so the three cannot drift.)
RECALL_BOT_NAME=Scout
# Public URL Recall can reach to deliver webhooks. Needs a tunnel in local dev:
#   ngrok http 8004   ->   https://<id>.ngrok-free.app
# Leave blank to run without live meeting capture.
WEBHOOK_BASE_URL=

# The SAME public hostname as above. Recall's cloud browser loads
# <this>/<session-token> and streams that page into the meeting as the bot's
# camera. Leaving it EMPTY does not degrade anything visibly: the backend skips
# output_media entirely, so the bot joins the call and is simply silent.
VOICE_AGENT_URL=

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# 'http' runs the ex-Lambda workers as local containers (the default for
# self-hosting). 'lambda' uses AWS via boto3 and the *_LAMBDA_ARN settings.
JOB_INVOKER=http
FEEDBACK_WORKER_URL=http://feedback-agent:9001
INTAKE_WORKER_URL=http://intake-agent:9002
CONTEXT_BUILDER_WORKER_URL=http://intake-context-builder:9003

# The intake context-builder reads these directly and fails on a missing one.
# CORTEX_TOKEN_URL is the backend endpoint it exchanges INTERNAL_API_SECRET at
# for a short-lived Cortex token.
CORTEX_TOKEN_URL=http://backend:8004/api/v2/internal/cortex/service-token

# ---------------------------------------------------------------------------
# Knowledge graph (Cortex) — added in the Cortex phase.
# ---------------------------------------------------------------------------
NEO4J_AUTH=neo4j/openrecruiting
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=openrecruiting
CORTEX_BACKEND_INTERNAL_URL=http://cortex-backend:8010
CORTEX_MCP_URL=http://cortex-mcp:8020
# Issuer cortex-mcp requires in the `iss` claim of tokens the backend mints.
# jwt_signer.py stamps it on EVERY token -- OAuth access tokens and internal
# service tokens alike -- so these two MUST stay equal. A mismatch fails every
# call with "Token verification failed: Invalid issuer", which surfaces in the
# UI as "We couldn't prefill from your context".
#
# Set BOTH to the public tunnel host if you want a remote MCP client (Claude)
# to connect: MCP_JWT_ISSUER also builds the OAuth discovery URLs the backend
# advertises (authorize/token/register/jwks), and localhost is meaningless from
# the client's side. The Caddyfile routes /api/* plus the /.well-known/*
# discovery paths to the backend so the public host resolves.
#
# JWKS *fetching* is unaffected either way: cortex-mcp's oidc_jwks_url is
# configured separately and stays on the internal compose network.
# Local-only (no remote client): http://localhost:8004 for both.
MCP_JWT_ISSUER=http://localhost:8004
OIDC_ISSUER=http://localhost:8004

# External URL MCP clients use to reach cortex-mcp. Advertised in the 401
# WWW-Authenticate `resource_metadata` param and the protected-resource doc.
# Unset defaults to http://localhost:8020, which stalls a remote client's
# discovery on step 2. Set it to the public tunnel host to expose MCP.
CORTEX_PUBLIC_URL=http://localhost:8020
# Must match INTERNAL_SECRET inside the cortex services or every call 401s.
CORTEX_INTERNAL_SECRET=change-me-local-only

# MCP token signing (optional). Without a key the MCP discovery endpoints report
# 503 "not configured" and the rest of the stack is unaffected. To enable:
#   openssl genrsa 2048
# and paste the PEM here as a single line with \n escapes.
MCP_JWT_PRIVATE_KEY_PEM=
MCP_JWT_KEY_ID=mcp-key-1

# --- LLM gateway -------------------------------------------------------------
# Applications talk to the LiteLLM proxy, never to a provider directly.
LLM_GATEWAY_URL=http://litellm:4000
# Shared secret the apps present to the gateway. Generate one: openssl rand -hex 32
LITELLM_MASTER_KEY=
# Comma-separated aliases forced onto emulated JSON tool calling, skipping the
# capability probe entirely.
#
# Pre-populated deliberately, not left blank. Capability detection reads
# /model/info and caches the answer; if that GET fails, every alias fails OPEN to
# "tool-capable" for the 30s negative-cache window. Native `tools` are then sent
# to a model that cannot use them, and because litellm-config.yaml sets
# `drop_params: true` the gateway DROPS them instead of erroring — the model
# answers as free prose, no tool call is ever made, and nothing anywhere reports
# a failure.
#
# For the Ollama aliases the answer is statically known (Gemma has no native
# function calling, and litellm-config.yaml already declares
# supports_function_calling: false for all three), so there is no reason to let a
# probe failure decide it. Listing them here makes the emulated path
# unconditional. Add any other alias you know has no native tool support.
LLM_FORCE_JSON_TOOLS=intake-jd-local,smoke-local,gemma-local
# Per-request timeout the apps apply, in seconds.
LLM_TIMEOUT_SECONDS=60
# Where a local Ollama is listening, as seen from inside a container.
OLLAMA_API_BASE=http://host.docker.internal:11434

# ─────────────────────────────────────────────────────────────────────────────
# WebRTC media relay  (TURN — required for meeting-bot voice, optional otherwise)
# ─────────────────────────────────────────────────────────────────────────────
# Browser-to-agent voice works without this on a laptop: both peers are on the
# same machine. A Recall meeting bot is NOT — it runs in Recall's cloud, and its
# media is UDP, which no HTTP tunnel carries. On AWS this worked because the
# voice agent had a public IP with UDP 40000-40010 open; behind NAT there is no
# such path.
#
# TURN fixes it: both peers connect OUTBOUND to a relay, so NAT stops mattering.
# Cloudflare's TURN has a free tier. Unset means browser voice still works and
# meeting-bot voice does not connect.
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ─────────────────────────────────────────────────────────────────────────────
# Email  (optional — unset means no mail is sent)
# ─────────────────────────────────────────────────────────────────────────────
# Interview invitations, feedback links, password resets.
# Two providers are implemented: zoho (ZeptoMail) and resend. The enum in
# backend/app/config.py also lists sendgrid and postmark, but the factory raises
# NotImplementedError for both — do not set EMAIL_PROVIDER to either.
EMAIL_PROVIDER=zoho
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=OpenRecruiting
# Required when EMAIL_PROVIDER=zoho
ZEPTOMAIL_API_TOKEN=
ZEPTOMAIL_BASE_URL=https://api.zeptomail.com/v1.1
# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Integrations  (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Knit powers ATS sync. Unset disables it — the feature flag stays on because
# the key is what actually decides whether sync can run.
KNIT_API_KEY=
ATS_INTEGRATIONS_ENABLED=true

# Shared secret for background-worker callbacks. Despite the name this is NOT
# Lambda-only: webhooks_feedback.py REJECTS every worker callback when it is
# unset, including on the default JOB_INVOKER=http path that posts to the local
# worker containers. Set it, or feedback results never come back.
LAMBDA_CALLBACK_SECRET=

# NOT LISTED HERE, deliberately: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_REGION and the S3 buckets. boto3 is installed and s3_service.py is real,
# but only two callers exist — the admin blog CMS image upload, and ATS resume
# enrichment. A self-hosted instance needs neither, and JOB_INVOKER defaults to
# "http" so the Lambda path is off. Listing them would imply an AWS account is
# part of setup. Add them by hand if you enable those features.
