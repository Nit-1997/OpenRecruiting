# Test image for cortex-backend (tag: openrecruiting-cortex-backend-test).
# Mirrors Dockerfile; pytest already ships in requirements.txt, so there is no
# separate test requirements file. Tests and live app code come from a bind
# mount at run time, so a code edit does not need a rebuild:
#
#   docker build -f cortex-backend/Dockerfile.test -t openrecruiting-cortex-backend-test cortex-backend
#   docker run --rm -e ENV=test -v "$PWD/cortex-backend:/app" -w /app \
#     openrecruiting-cortex-backend-test python -m pytest -q -m "not live_infra" \
#     tests/unit tests/integration
#
# tests/unit and tests/integration are both hermetic: integration mocks SQS,
# Supabase and Graphiti and never enters the app lifespan, so no service is
# contacted. Mark anything that does need a real Neo4j/Supabase `live_infra`
# and it drops out of that run while still living in tests/integration.
#
# Two groups are left out, neither for infrastructure reasons:
#   tests/e2e           - passes alone, fails in a full-tree run. Its fixture
#                         sets INTERNAL_SECRET in os.environ, but get_settings()
#                         is @lru_cache'd, so an earlier test that already built
#                         the settings object pins the old value (401 -> 500).
#   tests/test_health.py - always fails: @pytest.fixture on an async generator,
#                         which pytest-asyncio strict mode does not run.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY application.yaml .
COPY src/ src/
