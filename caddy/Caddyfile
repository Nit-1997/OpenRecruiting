# One public hostname, path-routed to the local services.
#
# This exists because the frontend expects voice-agent at /voice-ws-v2 on the
# SAME ORIGIN (recruiter-app IntakeCallProvider.tsx:57), and voice-frontend's
# status URL uses window.location.host off localhost. Four separate tunnels
# would give four hostnames and break both. The reverse proxy that used to
# provide this lived in deploy-config/, which is not in this repo.
#
# Terminating TLS is Cloudflare's job — cloudflared connects to :80 inside the
# compose network, so nothing here is exposed to the host.

{
	admin off
	auto_https off
}

:80 {
	log {
		output stdout
		format console
	}

	# WebRTC signalling for the voice agent. Must come before the catch-all.
	handle_path /voice-ws-v2/* {
		reverse_proxy voice-agent:8011
	}

	# The MCP server an assistant connects to. `handle`, not `handle_path`:
	# cortex-mcp mounts the streamable-HTTP transport AT /mcp (src/main.py), so
	# stripping the prefix proxied / and 404'd. Both matchers because /mcp/*
	# alone does not match a bare /mcp — that fell through to the catch-all and
	# served the voice-frontend HTML with a 200, which is worse than a 404.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy cortex-mcp:8020
	}

	# OAuth discovery for the MCP connector. RFC 9728 / RFC 8414 put these on
	# the RESOURCE and ISSUER origins respectively, which means the app root —
	# not under /mcp or /api. Without explicit routes the catch-all answers them
	# with voice-frontend HTML, and the connector handshake dies on step 2.
	#   oauth-protected-resource -> cortex-mcp (it is the resource server)
	#   oauth-authorization-server + jwks.json -> backend (it mints the tokens)
	handle /.well-known/oauth-protected-resource {
		reverse_proxy cortex-mcp:8020
	}

	@mcp_authz path /.well-known/oauth-authorization-server /.well-known/jwks.json
	handle @mcp_authz {
		reverse_proxy backend:8004
	}

	# Backend: Recall webhooks land here, and voice-frontend's same-origin
	# status polling resolves to /api/* on this host.
	handle /api/* {
		reverse_proxy backend:8004
	}

	# Everything else is the page Recall's cloud browser loads as the bot's
	# camera. It is the catch-all on purpose: the bot is handed
	# https://<host>/<session-token>, a bare path with no prefix to match on.
	handle {
		reverse_proxy voice-frontend:3000
	}
}
