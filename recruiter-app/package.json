{
  "name": "recruiter-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../.env -- next dev --port 3005",
    "build": "next build",
    "start": "dotenv -e ../.env -- next start --port 3005",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:coverage:gate": "bun scripts/coverage-gate.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@deepgram/sdk": "^4.11.3",
    "@pipecat-ai/client-js": "^1.6.0",
    "@pipecat-ai/client-react": "^1.1.0",
    "@pipecat-ai/small-webrtc-transport": "^1.6.0",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "^2.106.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.6.0",
    "next": "16.2.4",
    "pdfjs-dist": "^4.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.3.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.12",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.0",
    "dotenv-cli": "^11.0.0",
    "happy-dom": "^20.9.0",
    "lefthook": "2.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
