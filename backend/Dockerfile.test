# Test image for the backend (tag: openrecruiting-backend-test).
# Mirrors Dockerfile but also installs requirements-test.txt. Tests and live app
# code come from a bind mount at run time, so a code edit does not need a rebuild:
#
#   docker build -f backend/Dockerfile.test -t openrecruiting-backend-test .
#   docker run --rm -e ENV=test -v "$PWD/backend:/app" -w /app \
#     openrecruiting-backend-test python -m pytest -q
#
# intake-core and llm-core are baked into the image, so rebuild after ANY change
# under either or backend imports will resolve to a stale copy.
FROM python:3.11-slim

WORKDIR /app

COPY backend/requirements.txt backend/requirements-test.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-test.txt

COPY intake-core /tmp/intake-core
RUN pip install --no-cache-dir /tmp/intake-core && rm -rf /tmp/intake-core

# llm-core is the shared gateway client. It also carries a pytest11 entry point,
# so installing it here is what makes the `fake_llm` fixture exist in this image.
# backend/Dockerfile already installs it; the test image was missed, which would
# have surfaced as a collection error rather than a readable failure.
COPY llm-core /tmp/llm-core
RUN pip install --no-cache-dir /tmp/llm-core && rm -rf /tmp/llm-core

# The gateway alias map. Backend tests assert properties of it that cannot be
# checked at runtime: that the streaming aliases declare native tool support (a
# `false` there silently stops the intake agent persisting any answer), and that
# every alias a setting names actually exists. `make test` mounts only backend/,
# so the repo root is not reachable from inside the container and the file has to
# be baked in. Solved this way rather than with a skipif — a skipped guard is not
# a guard, and this plan forbids new skips.
COPY litellm-config.yaml /litellm-config.yaml

# Every other service's SOURCE, for the one repo-wide assertion this migration
# ends on: test_no_application_module_holds_a_provider_credential. Each service's
# own suite can only see its own tree, and "no application anywhere holds a
# provider credential" is precisely the property no per-service scan can check —
# it is how two backend modules egressed to a provider for seven phases and how
# voice-agent kept the last provider key while every suite stayed green.
# Baked for the same reason as litellm-config.yaml above: `make test` mounts only
# backend/, and a guard that skips is not a guard. Source only, ~2.4 MB, and the
# image is rebuilt on every `make test` so these cannot go stale.
COPY voice-agent/src /repo-scan/voice-agent/src
COPY intake-core/intake_core /repo-scan/intake-core/intake_core
COPY llm-core/llm_core /repo-scan/llm-core/llm_core
COPY workers /repo-scan/workers

COPY backend/ /app/
